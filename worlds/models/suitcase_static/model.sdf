<?xml version='1.0' ?>
<!--
  Suitcase standing upright on its short edge.
  Rotated 90° around Y (pitch=π/2) so the longest axis (~0.19 m) is vertical.
  Scaled 1.5× to bring total height to ~0.29 m — well above 0.17 m lidar scan plane.
  Floor contact: bottom edge at z ≈ 0 m, top at z ≈ 0.29 m.
-->
<sdf version="1.6">
    <model name="suitcase_static">
        <static>true</static>
        <link name="link">
            <pose>0 0 0 0 1.5708 0</pose>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://suitcase/meshes/SmallCase.dae</uri>
                        <scale>1.5 1.5 1.5</scale>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0</specular>
                    <pbr>
                        <metal>
                            <albedo_map>model://suitcase/materials/textures/SmallCase_Albedo.jpg</albedo_map>
                            <normal_map>model://suitcase/materials/textures/SmallCase_Normal.jpg</normal_map>
                            <roughness_map>model://suitcase/materials/textures/SmallCase_Roughness.jpg</roughness_map>
                            <metalness_map>model://suitcase/materials/textures/SmallCase_Metalness.png</metalness_map>
                        </metal>
                    </pbr>
                </material>
            </visual>
            <collision name="body">
                <pose>0 0 0.145 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.054 0.18 0.29</size>
                    </box>
                </geometry>
            </collision>
        </link>
  <plugin name="gz::sim::systems::Label" filename="gz-sim-label-system">
    <label>1</label>
  </plugin>
    </model>
</sdf>