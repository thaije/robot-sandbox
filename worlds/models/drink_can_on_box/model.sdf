<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drink_can_on_box">
    <static>true</static>

    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>1</label>
    </plugin>

    <!-- Cardboard box base: 0.20 x 0.20 x 0.12 m, bottom at z=0 -->
    <link name="box_link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="box_vis">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box><size>0.20 0.20 0.12</size></box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>0.70 0.60 0.40 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <collision name="box_col">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box><size>0.20 0.20 0.12</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Drink can on top of the box: bottom at z=0.12, top at z≈0.24 -->
    <link name="can_link">
      <pose>0 0 0.12 0 0 0</pose>
      <visual name="can_vis">
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/coke/6/files/meshes/coke.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="can_col">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.122</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>